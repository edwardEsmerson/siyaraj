introduction = Array[Dictionary]([{"texture": "res://assets/backgrounds/title_skyline.png", "subject": "res://assets/sprites/swaminathan-head/faces/01.png", "speaker": "Swaminathan", "text": "You have reached Lanka, Siya. Ten heads stand between you and Raj."}, {"texture": "res://assets/backgrounds/title_skyline.png", "subject": "res://assets/sprites/swaminathan-head/faces/01.png", "speaker": "Siya", "text": "Then I will bring down every one of them."}, {"texture": "res://assets/backgrounds/title_skyline.png", "subject": "res://assets/sprites/swaminathan-head/faces/01.png", "speaker": "Robin", "text": "Watch the glowing heads. Find the safe lanes, then strike when he is spent."}])
