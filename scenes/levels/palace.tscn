script = ExtResource("Script")
level_id = "palace"
sections = PackedStringArray("Palace gates / Climb the broken lintel. Lower ledges catch missed jumps.", "Column gallery / Vault the bases for cover, or take the upper gallery.", "Broken roofs / Dash between roofs. Lower courtyards offer a second route.", "Inner hall / Dash past a swing; flank the shooter from the balcony.", "Sanctum / Fight on the broad platform before the final roof crossing.", "Throne approach / Light the last diya, then enter Swaminathan's arena.")
